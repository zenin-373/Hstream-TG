# Required
BOT_TOKEN=123456:ABC-DEF...

# Optional – your Telegram user ID (for future owner-only commands)
OWNER_ID=0

# Max size (MB) the bot will try to send via Telegram (default ~49)
MAX_FILE_MB=49

# Where to store temporary downloads
DOWNLOAD_ROOT=downloads

# Where per-user cookies.txt are kept
COOKIES_DIR=user_cookies

# Keep finished files after sending? (true/false)
KEEP_FILES=false

# Concurrent download workers
WORKERS=2
